DATABASE_URL=postgresql://localhost/ooc
PORT=3000  # optional

SLACK_USER_ID=U  # user id of the OOC user (not bot)
SLACK_OOC_CHANNEL=C  # channel id of the OOC channel
SLACK_REVIEW_CHANNEL=C  # channel id of the internal review channel

SLACK_BOT_TOKEN=xoxb-
SLACK_USER_TOKEN=xoxp-  # should be installed by the OOC user
SLACK_XOXD_TOKEN=xoxd-  # grab from cookies, should not be urlencoded
SLACK_XOXC_TOKEN=xoxc-
SLACK_SIGNING_SECRET=
